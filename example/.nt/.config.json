{
  "core": {
    "extensions": [
      "md",
      "markdown"
    ],
    "medias": {
      "command": "ffmpeg",
      "parallel": 1,
      "preset": "ultrafast"
    }
  },
  "attributes": {
    "attended_date": {
      "name": "attended_date",
      "type": "string",
      "format": "yyyy-mm-dd",
      "memory": true,
      "inherit": true,
      "preserveShorthand": true
    },
    "date": {
      "name": "date",
      "type": "string",
      "format": "date",
      "inherit": true,
      "preserveShorthand": null
    },
    "draft": {
      "name": "draft",
      "type": "bool",
      "format": "",
      "inherit": false,
      "preserveShorthand": true
    },
    "due": {
      "name": "due",
      "type": "date",
      "format": "",
      "inherit": true,
      "preserveShorthand": true
    },
    "hook": {
      "name": "hook",
      "type": "string[]",
      "format": "",
      "inherit": false,
      "preserveShorthand": null
    },
    "inspirations": {
      "name": "inspirations",
      "type": "string[]",
      "format": "markdown",
      "inherit": false,
      "preserveShorthand": null
    },
    "isbn": {
      "name": "isbn",
      "type": "string",
      "format": "isbn",
      "inherit": true,
      "preserveShorthand": true
    },
    "name": {
      "name": "name",
      "aliases": [
        "author"
      ],
      "type": "string",
      "format": "markdown",
      "inherit": true,
      "preserveShorthand": true
    },
    "occupation": {
      "name": "occupation",
      "type": "string",
      "format": "markdown",
      "inherit": true,
      "preserveShorthand": true
    },
    "priority": {
      "name": "priority",
      "type": "string",
      "format": "",
      "inherit": true,
      "shorthands": {
        "❗️": "high",
        "🔼": "medium",
        "🔽": "low",
        "🚨": "urgent"
      },
      "preserveShorthand": false,
      "defaultValue": "medium"
    },
    "rating": {
      "name": "rating",
      "type": "string",
      "format": "",
      "inherit": true,
      "allowedValues": [
        "★",
        "★★",
        "★★★"
      ],
      "shorthands": {
        "★": "★",
        "★★": "★★",
        "★★★": "★★★"
      },
      "preserveShorthand": true,
      "defaultValue": "★★"
    },
    "read_date": {
      "name": "read_date",
      "type": "string",
      "format": "yyyy-mm-dd",
      "memory": true,
      "inherit": true,
      "preserveShorthand": true
    },
    "references": {
      "name": "references",
      "type": "string[]",
      "format": "markdown",
      "inherit": false,
      "preserveShorthand": null
    },
    "slug": {
      "name": "slug",
      "type": "string",
      "format": "",
      "inherit": false,
      "preserveShorthand": null
    },
    "source": {
      "name": "source",
      "type": "string",
      "format": "markdown",
      "inherit": true,
      "preserveShorthand": null
    },
    "status": {
      "name": "status",
      "aliases": [
        "state"
      ],
      "type": "string",
      "format": "",
      "inherit": true,
      "shorthands": {
        "⏱️": "in-progress",
        "⏸️": "on-hold",
        "✅": "done",
        "❌": "cancelled",
        "❓": "to-refine",
        "📅": "planned",
        "📝": "todo",
        "🗄️": "archived",
        "🚧": "blocked"
      },
      "preserveShorthand": false,
      "defaultValue": "todo"
    },
    "tags": {
      "name": "tags",
      "type": "string[]",
      "format": "",
      "inherit": true,
      "preserveShorthand": null
    },
    "title": {
      "name": "title",
      "type": "string",
      "format": "",
      "inherit": false,
      "preserveShorthand": null
    }
  },
  "noteTypes": {
    "Artwork": {
      "name": "Artwork",
      "pattern": "(?i)^Artwork:\\s*(.*)$",
      "processors": null,
      "attributes": [
        {
          "name": "artist",
          "required": false,
          "promoteInline": false
        },
        {
          "name": "year",
          "required": false,
          "promoteInline": false
        }
      ],
      "hooks": null
    },
    "BookReview": {
      "name": "BookReview",
      "pattern": "(?i)^BookReview:\\s*(.*)$",
      "processors": null,
      "attributes": [
        {
          "name": "isbn",
          "required": true,
          "promoteInline": false
        },
        {
          "name": "draft",
          "required": true,
          "promoteInline": false
        },
        {
          "name": "rating",
          "required": true,
          "promoteInline": false
        },
        {
          "name": "read_date",
          "required": true,
          "promoteInline": false
        }
      ],
      "hooks": null
    },
    "Cheatsheet": {
      "name": "Cheatsheet",
      "pattern": "(?i)^Cheatsheet:\\s*(.*)$",
      "processors": null,
      "hooks": null
    },
    "Flashcard": {
      "name": "Flashcard",
      "pattern": "(?i)^Flashcard:\\s*(.*)$",
      "processors": [
        "flashcard-extractor"
      ],
      "attributes": [
        {
          "name": "srs.algorithm",
          "required": false,
          "promoteInline": false
        },
        {
          "name": "srs.boostFactor",
          "required": false,
          "promoteInline": false
        }
      ],
      "hooks": null
    },
    "Generator": {
      "name": "Generator",
      "pattern": "(?i)^Generator:\\s*(.*)$",
      "processors": [
        "generator",
        "list-items"
      ],
      "attributes": [
        {
          "name": "file",
          "required": false,
          "promoteInline": false
        },
        {
          "name": "interpreter",
          "required": false,
          "promoteInline": false
        }
      ],
      "hooks": null
    },
    "Idea": {
      "name": "Idea",
      "pattern": "(?i)^Idea:\\s*(.*)$",
      "processors": null,
      "hooks": null
    },
    "Journal": {
      "name": "Journal",
      "pattern": "(?i)^Journal:\\s*(.*)$",
      "processors": [
        "date-extractor",
        "list-items"
      ],
      "attributes": [
        {
          "name": "date",
          "required": true,
          "promoteInline": false
        }
      ],
      "hooks": null
    },
    "List": {
      "name": "List",
      "pattern": "(?i)^List:\\s*(.*)$",
      "processors": [
        "list-items"
      ],
      "hooks": null
    },
    "Master": {
      "name": "Master",
      "pattern": "(?i)^Master:\\s*(.*)$",
      "processors": null,
      "hooks": null
    },
    "Note": {
      "name": "Note",
      "pattern": "(?i)^Note:\\s*(.*)$",
      "processors": null,
      "hooks": null
    },
    "Quote": {
      "name": "Quote",
      "pattern": "(?i)^Quote:\\s*(.*)$",
      "processors": [
        "quote-rewriter"
      ],
      "attributes": [
        {
          "name": "name",
          "required": true,
          "promoteInline": false
        },
        {
          "name": "occupation",
          "required": true,
          "promoteInline": false
        }
      ],
      "hooks": null
    },
    "ReadingList": {
      "name": "ReadingList",
      "pattern": "(?i)^ReadingList:\\s*(.*)$",
      "processors": [
        "list-items"
      ],
      "attributes": [
        {
          "name": "rating",
          "required": false,
          "promoteInline": false
        }
      ],
      "hooks": null
    },
    "Routine": {
      "name": "Routine",
      "pattern": "(?i)^Routine:\\s*(.*)$",
      "processors": null,
      "hooks": null
    },
    "Synopsis": {
      "name": "Synopsis",
      "pattern": "(?i)^Synopsis:\\s*(.*)$",
      "processors": null,
      "hooks": null
    },
    "Task": {
      "name": "Task",
      "pattern": "(?i)^Task:\\s*(.*)$",
      "processors": null,
      "attributes": [
        {
          "name": "status",
          "required": true,
          "promoteInline": false
        },
        {
          "name": "due",
          "required": false,
          "promoteInline": false
        },
        {
          "name": "priority",
          "required": false,
          "promoteInline": false
        }
      ],
      "hooks": null
    },
    "Todo": {
      "name": "Todo",
      "pattern": "(?i)^Todo:\\s*(.*)$",
      "processors": [
        "list-items"
      ],
      "attributes": [
        {
          "name": "status",
          "required": true,
          "promoteInline": false
        },
        {
          "name": "due",
          "required": false,
          "promoteInline": false
        },
        {
          "name": "priority",
          "required": true,
          "promoteInline": false
        }
      ],
      "hooks": null
    }
  },
  "fileTypes": {},
  "remotes": null,
  "queries": null,
  "linter": {
    "rules": [
      {
        "name": "no-empty-title",
        "args": null
      },
      {
        "name": "no-duplicate-note-title",
        "args": null
      },
      {
        "name": "no-duplicate-slug",
        "args": null
      },
      {
        "name": "no-dangling-media",
        "args": null
      },
      {
        "name": "no-dead-wikilink",
        "args": null
      },
      {
        "name": "no-extension-wikilink",
        "args": null
      },
      {
        "name": "no-ambiguous-wikilink",
        "args": null
      },
      {
        "name": "no-orphan-flashcard",
        "args": null
      },
      {
        "name": "require-tag",
        "args": [
          "^(focusing|reading|understanding|knowing|learning|mastering|doing|being|reflecting|living|suffering|loving|problem-solving|thinking|programming|planning|writing|note-taking|aging|dying)$"
        ],
        "query": "type:Quote"
      }
    ]
  },
  "references": null,
  "decks": [
    {
      "name": "Skills",
      "query": "path:resources/skills",
      "boostFactor": 100,
      "newFlashcardsPerDay": 10,
      "maxFlashcardsPerDay": 0,
      "algorithm": "nt-0",
      "algorithmSettings": {
        "easeFactor": 2.5
      }
    },
    {
      "name": "General",
      "query": "",
      "boostFactor": 100,
      "newFlashcardsPerDay": 10,
      "maxFlashcardsPerDay": 0,
      "algorithm": "nt-0",
      "algorithmSettings": {
        "easeFactor": 2.5
      }
    }
  ],
  "desks": null,
  "journals": null,
  "stats": null,
  "books": null
}